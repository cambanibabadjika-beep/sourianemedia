# ============================================================================
#  SOURIANE — Configuration de l’environnement
#  Copier ce fichier vers .env et renseigner les valeurs réelles.
#  Le fichier .env ne doit jamais être versionné.
# ============================================================================

# --- Application ------------------------------------------------------------
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost/sourianemedia
APP_NAME=Souriane
APP_SLOGAN="Votre panneau vous parle"

# --- Base de données --------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=souriane
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# --- Domaine court utilisé dans les QR codes --------------------------------
# Le QR code encode une URL courte de la forme {COURT_DOMAINE}/{code}.
# L’adresse directe de la page n’est jamais encodée (ch. 5.1).
COURT_DOMAINE=sr.n

# --- Sécurité ---------------------------------------------------------------
# Clé servant à dériver l’empreinte non réversible des adresses réseau.
# Générer : php -r "echo bin2hex(random_bytes(32));"
HASH_SECRET=changez_cette_cle_de_32_octets_minimum_0000000000
SESSION_NAME=souriane_session

# --- Notifications push (VAPID) --------------------------------------------
# Générer : php cron/generer_cles.php
VAPID_SUBJECT=mailto:contact@souriane.sn
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# --- Limitation de débit ----------------------------------------------------
RATE_LIMIT_WINDOW=60
RATE_LIMIT_MAX=60

# --- Tâche planifiée --------------------------------------------------------
# Jeton exigé par cron/envoyer_notifications.php lorsqu’il est appelé par HTTP,
# sur un hébergement dépourvu de crontab. Laisser vide si le script n’est
# exécuté qu’en ligne de commande.
# Générer : php -r "echo bin2hex(random_bytes(24));"
CRON_TOKEN=

# --- Contact ----------------------------------------------------------------
WHATSAPP_REGIE=+221770000000

# --- Vérification en deux étapes (ch. 8) ------------------------------------
# Nom affiché dans l’application d’authentification, devant l’adresse du
# compte. « Souriane:admin@souriane.sn » se lit mieux que « admin@souriane.sn »
# quand on a plusieurs comptes enrôlés.
SECURITE_2FA_EMETTEUR=Souriane

# Dérogation de développement : dispense de saisir le code à deux facteurs à la
# connexion. À laisser à false hors phase de développement. Ignorée si
# APP_ENV=production. Elle ne supprime rien : les secrets rangés restent en
# place, et repasser le réglage à false rétablit l’exigence sans réenrôlement.
SECURITE_2FA_SANS_CODE=false

# Clé partagée des comptes de démonstration. Renseignée automatiquement par
# `php cron/preparer_2fa_demo.php`, qui refuse de s’exécuter hors mode
# démonstration (APP_DEBUG). En production, laisser vide : chaque compte
# enrôle son propre appareil depuis « Sécurité du compte », et cette clé ne
# doit jamais être publiée.
SECURITE_2FA_SECRET_DEMO=
