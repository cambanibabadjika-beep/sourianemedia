# Secrets (mots de passe BDD, clés VAPID, etc.) — ne JAMAIS publier
.env
.env.*
!.env.example

# Données générées à l'exécution
storage/limites/
storage/logs/*
!storage/logs/.gitignore
storage/uploads/*
!storage/uploads/.gitignore

# Sauvegardes de la base (cron/sauvegarder_base.php) — jamais publiées
storage/sauvegardes/
storage/sauvegarde.lock

# Sorties de l'audit de thème sombre (tests/audit_sombre.js)
audit-sombre.json
storage/audit-*.json
storage/audit-*.log

# Captures et relevés de diagnostic (tests/sonde_*.js)
*-sombre.png
badge-*.png
storage/net*.txt

# Scripts de débogage locaux
repro_*.php

# Outils / IDE / système
.workbuddy-ai/
.vscode/
.idea/
Thumbs.db
node_modules/
package-lock.json
.DS_Store
