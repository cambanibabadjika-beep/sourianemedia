{
    "name": "Souriane — Votre panneau vous parle",
    "short_name": "Souriane",
    "description": "La plateforme d’affichage extérieur connecté : chaque panneau porte un QR code qui ouvre la page de l’annonceur, puis permet d’installer l’application et de recevoir ses offres.",
    "lang": "fr",
    "dir": "ltr",
    "id": "./",
    "start_url": "./",
    "scope": "./",
    "display": "standalone",
    "display_override": ["standalone", "minimal-ui", "browser"],
    "orientation": "portrait-primary",
    "background_color": "#FFFFFF",
    "theme_color": "#4C1D95",
    "categories": ["business", "shopping", "news"],
    "prefer_related_applications": false,
